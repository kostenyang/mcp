# Copy to .env and fill in. Do NOT commit .env or mcpo/config.json (see .gitignore).

# Bearer token the MCP requires; must match the token in mcpo/config.json
SRM_MCP_API_KEYS=change-me-to-a-random-token

# MCP runtime mode
SRM_LIVE=0                 # 0=MOCK (safe, no lab); 1=hit real 192.168.114.x appliances
SRM_ALLOW_ACTIONS=0        # 1=enable destructive tools (recovery/pairing/vm write)
SRM_SSO_PASS=              # vCenter SSO pw (only needed when SRM_LIVE=1)
SRM_APPLIANCE_PASS=        # SRM/VR appliance VAMI pw (only needed when SRM_LIVE=1)

# External OpenAI-compatible LLM for OpenWebUI (must support tool/function calling)
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
