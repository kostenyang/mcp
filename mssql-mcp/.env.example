# --- mcpo HTTP gate ---
# Bearer that clients (Open WebUI / Claude Desktop) must present to call this MCP.
MCPO_API_KEY=change-me-mssql-mcp-secret

# --- MSSQL connection ---
SERVER_NAME=mssql.home.lab
SERVER_PORT=1433
DATABASE_NAME=master

# SQL auth (on-prem). Leave blank to fall back to Azure AD InteractiveBrowserCredential.
SQL_USER=sa
SQL_PASSWORD=

# --- Behaviour ---
# READONLY=true exposes only read tools (list_table / read_data / describe_table).
READONLY=false

# For self-signed / non-TLS MSSQL (typical lab install). Keep true unless DB has a valid cert.
TRUST_SERVER_CERTIFICATE=true

# Optional. Disable TLS to DB entirely with ENCRYPT=false. Stay true for prod.
ENCRYPT=true

CONNECTION_TIMEOUT=30
